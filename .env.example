# Copy this file to .env (same folder) and fill in the blanks:
#   cp .env.example .env
# .env is gitignored. Never commit real keys, and never put keys in frontend code.

# --- Gemini (reading letters, text-to-speech) ---
# API key from Google AI Studio. Server-side only.
GEMINI_API_KEY=
# Model names live only here and in backend/app/config.py.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# --- Nessie (Capital One mock bank API; mock money only) ---
NESSIE_BASE_URL=https://api.nessieisreal.com
# API key from the Nessie site. Server-side only.
NESSIE_API_KEY=
# Leave these two empty. `python -m scripts.seed_nessie` writes them for you.
NESSIE_CUSTOMER_ID=
NESSIE_ACCOUNT_ID=
# Comma-separated ids of our three seeded merchants (written by the seed script).
NESSIE_MERCHANT_IDS=
# Starting balance of the demo account, in cents (200000 = $2,000.00 of mock money).
SEED_BALANCE_CENTS=200000

# --- Audit log storage ---
# MongoDB connection string. Leave empty to use a local JSONL file instead.
MONGODB_URI=

# --- Demo mode ---
# 1 or true = use the in-memory mock bank instead of calling Nessie. 0 = call Nessie.
DEMO_OFFLINE=0

# --- Signing secret for confirmation tokens ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=

# --- Phone access (optional) ---
# Your free fixed ngrok address, e.g. my-name.ngrok-free.app (no https://).
# Claim it at https://dashboard.ngrok.com/domains and run
# `ngrok config add-authtoken <your token>` once. Then use ./start_tunnel.sh
NGROK_DOMAIN=
